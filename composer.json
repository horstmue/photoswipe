{
  "name": "horstmue/photoswipe",
  "type": "typo3-cms-extension",
  "description": "TYPO3 PhotoSwipe-Plugin for native image-enlargement and caption",
  "license": "GPL-2.0-or-later",
  "version": "4.0.0",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "typo3/cms-backend": "^13.4 || ^14.0",
    "typo3/cms-core": "^13.4 || ^14.0",
    "typo3/cms-frontend": "^13.4 || ^14.0"
  },
  "authors": [
    {
      "name": "Tobias Eichelbegrer",
      "role": "Developer"
    },
    {
      "name": "Natascha Becker",
      "role": "Developer"
    }
  ],
  "keywords": [
    "typo3",
    "extension",
    "photoswipe",
    "lightbox",
    "image zoom",
    "layer"
  ],
  "support": {
    "issues": "https://github.com/j0nnybrav079/photoswipe/issues"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "photoswipe"
    }
  },
  "replace": {
    "typo3-ter/photoswipe": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Tei\\PhotoSwipe\\": "Classes"
    }
  }
}
